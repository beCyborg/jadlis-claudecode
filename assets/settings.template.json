{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "skillListingMaxDescChars": 600,
  "skillListingBudgetFraction": 0.01,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "100000",
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5",
    "CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX": "MBP",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_WORKFLOW_MAX_CONCURRENT_AGENTS": "36"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(bun *)",
      "Bash(python3 *)",
      "Bash(perl -ne *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git push origin *)",
      "Bash(git rm *)",
      "Bash(git remote *)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(fd *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(xargs *)",
      "Bash(xxd *)",
      "Bash(bats *)",
      "Bash(yt-dlp *)",
      "Bash(brew list *)",
      "Bash(brew search *)",
      "Bash(jq *)",
      "Bash(bash *)",
      "Bash(cd *)",
      "Bash(test *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(curl *)",
      "Edit",
      "Read",
      "Skill(*)",
      "mcp__plugin_jadlis-search_reddit__*",
      "mcp__plugin_github_github__*",
      "mcp__computer-use",
      "mcp__plugin_jadlis-search_firecrawl__*",
      "mcp__plugin_jadlis-search_brave-search__*",
      "mcp__plugin_jadlis-search_reddit-alt__*",
      "mcp__plugin_jadlis-search_youtube__*"
    ],
    "deny": [
      "WebSearch",
      "WebFetch",
      "Agent(claude-code-guide)",
      "mcp__plugin_jadlis-search_firecrawl__firecrawl_search",
      "mcp__plugin_jadlis-search_firecrawl__firecrawl_search_feedback",
      "mcp__plugin_jadlis-search_firecrawl__firecrawl_feedback",
      "mcp__plugin_jadlis-search_firecrawl__firecrawl_developer_search"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5-5",
  "fallbackModel": [
    "claude-opus-5-5"
  ],
  "skillOverrides": {
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "run": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-title.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/rename-topic-from-prompt.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__computer-use__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/cu-autoapprove-hook.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-traps.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/plan-bypass-hook.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/uv run --no-project -q --with pymorphy3 python ~/.claude/scripts/ste-ru-lint.py --hook",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "disableAgentView": false,
  "disableRemoteControl": false,
  "bashOutputMaxChars": 128000,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "outputStyle": "Jadlis",
  "viewMode": "default",
  "language": "Russian",
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Варю",
      "Завариваю",
      "Колдую",
      "Мастерю",
      "Кую",
      "Плету",
      "Мудрю",
      "Кумекаю",
      "Кручу",
      "Укрощаю",
      "Дирижирую",
      "Сочиняю",
      "Проектирую",
      "Призываю",
      "Шаманю",
      "Синтезирую",
      "Стряпаю",
      "Считаю",
      "Черчу",
      "Замышляю",
      "Перемалываю",
      "Обрабатываю",
      "Рождаю",
      "Строю",
      "Гитифицирую"
    ]
  },
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-4-8": {
      "effortLevel": "high"
    }
  },
  "showClearContextOnPlanAccept": true,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "voice": {
    "enabled": false
  },
  "timeFormat": "24-hour",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/.claude/memory",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "autoCompactEnabled": true,
  "idleCompaction": false,
  "switchModelsOnFlag": true,
  "autoScrollEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
